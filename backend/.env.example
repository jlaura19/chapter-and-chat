# Copy to .env and adjust. Never commit real secrets.

# SQLAlchemy URL. Dev default is SQLite; production uses PostgreSQL.
# DATABASE_URL=postgresql+psycopg://bookclub:change-me@localhost:5432/bookclub
DATABASE_URL=sqlite:///./bookclub.db

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# List settings use JSON syntax.
# Origins allowed by CORS.
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]

# Usernames that receive the admin role on signup.
ADMIN_USERNAMES=[]
